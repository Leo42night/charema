// !!> sayangnya prisma tidak dapat migrate pakai database_url selain file://, 
// Jadi migrasi manual ubah query sqlite ke postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-pg"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// simpan data target input mahasiswa, matkul yang diambil semester ini
model RecomTarget { 
  // user key key dari proses index user-items CF, value key matkuls disiman di JSON file
  id          Int   @id @default(autoincrement()) // bisa ada beberapa recom
  user_key    Int   
  // JSON [1,2,3], value key matkuls disiman di JSON file
  // !!! skema item_matkul.json perlu diarchive jika ada update
  matkul_ids  Json
  created_at  DateTime   @default(now()) // save tiap ada data baru
  updated_at  DateTime   @updatedAt // max 3 kali, setelah itu mode upsert data lama
}

// POST progress untuk simpan Score & Achievement 
// Simapn hasil score terhadap "apakah hasil rekomendasi membantu? 1-5", apakah score membantu
model Score {
  user_key    Int   @id // user_key sekarang menjadi identitas unik utama
  score_cf    Int
  score_chat  Int
  message     String? // kritik atau saran
  created_at  DateTime   @default(now()) // jadi catatan update untuk Achievement
}

model Achievement {
  user_key   Int   @id // user_key sekarang menjadi identitas unik utama
  tags       Json // ["greeting", "rekomendasi", dsb.]
  created_at  DateTime   @default(now()) // interaksi pertama (walaupun tidak langsung simpan)
}

// Feedback di limit 4 saja, jika ada feedback baru, lakukan upsert data lama
model Feedback {
  id          Int   @id @default(autoincrement())
  user_key    Int? // jika tidak ada maka email wajib
  email       String?
  input       String
  res_tag     String // "greeting"
  res_message String
  feedback    String
  created_at  DateTime   @updatedAt // jika update, maka berubah
}

// simpan data pemenang, jadi jika tag ter reset tidak masalah
model CalonWinner {
  user_key Int @id
  created_at  DateTime   @default(now()) // interaksi pertama
}

// ditampilkan di leaderboard
model User {
  userId    Int         @id @map("user_id")
  name      String?
  transaksi Transaksi[]

  @@map("users")
}

model Matkul {
  matkulId   Int         @id @map("matkul_id")
  matkul     String?
  kodeMatkul String?     @map("kode_matkul")
  sks        Decimal?
  transaksi  Transaksi[]

  @@map("matkul")
}

model Dosen {
  dosenId        Int              @id @map("dosen_id")
  dosen          String?          @unique
  transaksiDosen TransaksiDosen[]

  @@map("dosen")
}

model Prodi {
  prodiId   Int         @id @map("prodi_id")
  prodi     String?     @unique
  transaksi Transaksi[]

  @@map("prodi")
}

model Transaksi {
  id            Int              @id
  userId        Int?             @map("user_id")
  matkulId      Int?             @map("matkul_id")
  prodiId       Int?             @map("prodi_id")
  kelas         String?
  rating        Decimal?
  tahun         Int?
  sm            Int?
  smt           Int?
  matkulLower   String?          @map("matkul_lower")
  kelompokMinat String?          @map("kelompok_minat")
  category      Int?
  rate          Decimal?

  // Relasi
  user           User?            @relation(fields: [userId], references: [userId])
  matkul         Matkul?          @relation(fields: [matkulId], references: [matkulId])
  prodi          Prodi?           @relation(fields: [prodiId], references: [prodiId])
  transaksiDosen TransaksiDosen[]

  @@map("transaksi")
}

model TransaksiDosen {
  transaksiId Int @map("transaksi_id")
  dosenId     Int @map("dosen_id")

  // Relasi
  transaksi Transaksi @relation(fields: [transaksiId], references: [id])
  dosen     Dosen     @relation(fields: [dosenId], references: [dosenId])

  // Composite Primary Key
  @@id([transaksiId, dosenId])
  @@map("transaksi_dosen")
}