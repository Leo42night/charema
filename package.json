{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "devh": "bun run --filter '*' devh",
    "devpg": "bun run --filter '*' devpg",
    "dev-be": "bun run --filter 'backend' dev",
    "build": "bun run --filter '*' build",
    "preview": "bun run --filter '*' preview"
  }
}